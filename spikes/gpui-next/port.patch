+/// SPIKE: GPUI's own log lines on stderr with `MIRIN_METAL_GPUI_LOG=1` (which GPU
+/// adapter and backend wgpu chose, what the platform warned about).
+struct GpuiLog;
+
+impl log::Log for GpuiLog {
+    fn enabled(&self, metadata: &log::Metadata) -> bool {
+        metadata.level() <= log::Level::Info
+    }
+
+    fn log(&self, record: &log::Record) {
+        if self.enabled(record.metadata()) {
+            eprintln!(
+                "[gpui {}] {}: {}",
+                record.level(),
+                record.target(),
+                record.args()
+            );
+        }
+    }
+
+    fn flush(&self) {}
+}

+//! SPIKE (spikes/gpui-next): what mirin-metal takes from mirin's GPUI fork
+//! that current upstream GPUI lacks or shapes differently. Each item here is
+//! one row of docs/metal/gpui-next.md: either an adapter onto upstream's own
+//! API (layer shell) or a stand-in that keeps the crate compiling while the
+//! feature is off (grid track lists, retained subtrees).
+
+use gpui::{px, AnyElement, App, ElementId, EntityId, IntoElement, Window, WindowKind};
+
+/// One grid track, `minmax(min, max)`: the fork's `gpui::GridTrack`.
+/// STUB: upstream has only `repeat(N, minmax(_, 1fr))` (`GridTemplate`), so a
+/// track list is laid out as that many equal columns (`grid.rs`).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct GridTrack {
+    pub min: TrackBreadth,
+    pub max: TrackBreadth,
+}
+
+impl GridTrack {
+    pub fn new(breadth: TrackBreadth) -> Self {
+        let min = match breadth {
+            TrackBreadth::Fr(_) => TrackBreadth::Auto,
+            other => other,
+        };
+        Self { min, max: breadth }
+    }
+}
+
+/// The fork's `gpui::TrackBreadth`.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum TrackBreadth {
+    Pixels(f32),
+    Percent(f32),
+    Fr(f32),
+    Auto,
+    MinContent,
+    MaxContent,
+}
+
+pub use gpui::layer_shell::{KeyboardInteractivity, Layer};
+
+/// The fork's `gpui::LayerAnchor`; upstream's is a bitflags set.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct LayerAnchor {
+    pub top: bool,
+    pub bottom: bool,
+    pub left: bool,
+    pub right: bool,
+}
+
+/// The fork's `gpui::LayerMargin`; upstream's is a tuple of `Pixels`.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct LayerMargin {
+    pub top: i32,
+    pub right: i32,
+    pub bottom: i32,
+    pub left: i32,
+}
+
+/// The fork's `gpui::LayerShellOptions`, adapted onto upstream's
+/// `WindowKind::LayerShell` by [`LayerShellOptions::window_kind`].
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct LayerShellOptions {
+    pub namespace: String,
+    pub layer: Layer,
+    pub anchor: LayerAnchor,
+    pub exclusive_zone: i32,
+    pub margin: LayerMargin,
+    pub keyboard_interactivity: KeyboardInteractivity,
+    /// GAP: upstream picks the screen by `WindowOptions::display_id`, and a
+    /// `PlatformDisplay` has no connector name to match this against; the
+    /// spike leaves the screen to the compositor.
+    pub output: Option<String>,
+}
+
+impl LayerShellOptions {
+    pub fn window_kind(&self) -> WindowKind {
+        use gpui::layer_shell::Anchor;
+        let mut anchor = Anchor::empty();
+        anchor.set(Anchor::TOP, self.anchor.top);
+        anchor.set(Anchor::BOTTOM, self.anchor.bottom);
+        anchor.set(Anchor::LEFT, self.anchor.left);
+        anchor.set(Anchor::RIGHT, self.anchor.right);
+        WindowKind::LayerShell(gpui::layer_shell::LayerShellOptions {
+            namespace: self.namespace.clone(),
+            layer: self.layer,
+            anchor,
+            exclusive_zone: Some(px(self.exclusive_zone as f32)),
+            exclusive_edge: None,
+            margin: Some((
+                px(self.margin.top as f32),
+                px(self.margin.right as f32),
+                px(self.margin.bottom as f32),
+                px(self.margin.left as f32),
+            )),
+            keyboard_interactivity: self.keyboard_interactivity,
+        })
+    }
+}
+
+/// STUB for the fork's `gpui::retained`: upstream has no subtree that is
+/// kept across frames and sized by its content (`AnyView::cached` needs its
+/// size from outside). `retain::enabled()` is always false in the spike, so
+/// no boundary is ever made and this is never drawn.
+pub(crate) struct Retained;
+
+pub(crate) fn retained(
+    _id: impl Into<ElementId>,
+    _view: EntityId,
+    _version: u64,
+    _build: impl FnOnce(&mut Window, &mut App) -> AnyElement + 'static,
+) -> Retained {
+    Retained
+}
+
+impl Retained {
+    pub(crate) fn on_prepaint(
+        self,
+        _callback: impl FnOnce(bool, &mut Window, &mut App) + 'static,
+    ) -> Self {
+        self
+    }
+
+    pub(crate) fn into_any_element(self) -> AnyElement {
+        gpui::Empty.into_any_element()
+    }
+}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install",
  "buildCommand": "cd packages/docs && bun run build",
  "outputDirectory": "packages/docs/.output/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/_shell.html"
    }
  ]
}
